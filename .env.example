# Diese Datei nach .env kopieren und lokal mit echten Daten ausfuellen.
# .env darf nicht ins Repository eingecheckt werden.
# Fuer Microsoft 365 ist SMTP AUTH oft deaktiviert. Dann muss es im Tenant/Postfach erlaubt sein.

PORT=3000

# Passwort fuer die vorgeschaltete Anmeldeseite.
# Eigenes Passwort nur lokal in .env eintragen.
APP_PASSWORD=

# Beispiele:
# Microsoft 365: smtp.office365.com / 587 / false
# Gmail: smtp.gmail.com / 465 / true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TIMEOUT_MS=30000

# Absenderkonto
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional
SMTP_REPLY_TO=
